# URL de base de l'API ABMCY Core (par défaut https://api.abmcy.com)
ABMCY_API_BASE=https://api.abmcy.com

# Clé API publique du tenant Nathan — secret côté serveur uniquement,
# ne doit JAMAIS être préfixée NEXT_PUBLIC_ ni atteindre le navigateur.
STOREFRONT_API_KEY=pk_live_...

# Même URL de base, mais exposée au navigateur — utilisée uniquement pour
# les appels d'authentification client (/auth/customer/*), qui n'ont pas
# besoin de la clé API du tenant.
NEXT_PUBLIC_ABMCY_API_BASE=https://api.abmcy.com
