APP_ENV=production
PORT=8080

DATABASE_URL=postgres://abmcy_app:changeme@localhost:5432/abmcy?sslmode=disable
POSTGRES_PASSWORD=changeme

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_API_KEY=change-me-super-admin-key

# Chiffre/déchiffre les clés de service (R2, Resend, CinetPay) stockées en
# base — voir internal/platformconfig. Générer avec : openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# Les clés de service ci-dessous (Cloudflare R2, Resend, CinetPay) ne sont
# PLUS requises ici : elles se configurent depuis le dashboard super-admin
# (page Configuration) une fois l'API démarrée, et sont stockées chiffrées
# en base — voir internal/platformconfig. Le serveur démarre sans elles ;
# les fonctionnalités concernées répondent une erreur 503 claire tant
# qu'elles ne sont pas configurées.

CORS_ORIGINS=https://dash.abmcy.com,https://ad.abmcy.com
