APP_ENV=production
PORT=8080

DATABASE_URL=postgres://abmcy_app:changeme@localhost:5432/abmcy?sslmode=disable
POSTGRES_PASSWORD=changeme

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_API_KEY=change-me-super-admin-key

# Cloudflare R2 — stockage des images produits/tissus (compatible S3)
# Créer le bucket + un token API sur dash.cloudflare.com > R2, puis
# connecter un domaine public (ex: img.abmcy.com) au bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=abmcy-uploads
R2_PUBLIC_URL=https://img.abmcy.com

# https://resend.com/ — 100 emails/jour par tenant (quota interne côté abmcy)
RESEND_API_KEY=
RESEND_FROM_ADDR="ABMCY <no-reply@abmcy.com>"

# https://cinetpay.com/ — agrège Wave, Orange Money, MTN MoMo, cartes
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

CORS_ORIGINS=https://dash.abmcy.com,https://ad.abmcy.com
